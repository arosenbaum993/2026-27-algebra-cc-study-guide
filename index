 IB57D:{src:"GaDOE Item Bank 57A2024, Part A · DOK 1", stem:`<p>Ronald and Lucy made a map where each grid unit is a mile. Ronald is at (2, 1) and Lucy is at (6, 4). To the nearest mile, how far apart are they?</p>`,
  type:"num", fields:[["Distance (mi)",5,0.001]], tagFor:v => v===7 ? "Added the horizontal and vertical changes instead of using the distance formula" : "Distance formula error",
  why:"d = √((6 − 2)<sup>2</sup> + (4 − 1)<sup>2</sup>) = √(16 + 9) = √25 = 5 miles."},
 IB57M:{src:"GaDOE Item Bank 57A2024, Part B · DOK 1", stem:`<p>Ronald is at (2, 1) and Lucy is at (6, 4). What set of coordinates is the midpoint between them?</p>`,
  type:"num", fields:[["x",4,0.001],["y",2.5,0.001]], tagFor:(v,i) => (i===0&&v===2)||(i===1&&v===1.5) ? "Subtracted coordinates instead of averaging them" : "Midpoint formula error",
