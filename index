/* ---------- state ---------- */
const state = store.get("acc_state", {});
const queue = store.get("acc_queue", []);
const STD_OF = {}; const DOM_OF = {};
DOMAINS.forEach(d => d.standards.forEach(s => s.items.forEach(id => { STD_OF[id] = s.code; DOM_OF[id] = d.name; })));

function student(){
  return {name:$("#stuName").value.trim(), id:$("#stuId").value.trim(), teacher:$("#stuTeacher").value.trim(), period:$("#stuPeriod").value.trim()};
}
["stuName","stuId","stuTeacher","stuPeriod"].forEach(k => {
  const el = document.getElementById(k);
  el.value = store.get("acc_"+k, "");
  el.addEventListener("input", () => { store.set("acc_"+k, el.value); updateStatus(); });
});
function signedIn(){ const s = student(); return s.name && s.teacher && s.period; }
function updateStatus(){
  const el = $("#sendStatus");
  if(!SHEET_URL){ el.className = "status warn"; el.textContent = "Practice mode: this copy is not connected to your teacher's spreadsheet yet. Your answers are still checked and saved on this device."; return; }
  if(!signedIn()){ el.className = "status warn"; el.textContent = "Enter your name, teacher, and period before you practice so your teacher gets your results."; return; }
  el.className = "status ok"; el.textContent = queue.length ? `Signed in. ${queue.length} result(s) waiting to send.` : "Signed in. Your first try on each item will be sent to your teacher.";
}

/* ---------- logging ---------- */
function logResult(id, correct, response, correctAns, tag, attempt){
  const s = student();
  const row = {timestamp:new Date().toISOString(), version:GUIDE_VERSION, studentName:s.name, studentId:s.id, teacher:s.teacher, period:s.period,
    itemId:id, source:ITEMS[id].src, domain:DOM_OF[id], standard:STD_OF[id], correct:correct?1:0, response, correctAnswer:correctAns, misconception:correct?"":tag, attempt};
  queue.push(row); store.set("acc_queue", queue); flush();
}
let flushing = false;
async function flush(){
  if(!SHEET_URL || !signedIn() || flushing || !queue.length){ updateStatus(); return; }
  flushing = true;
  const batch = queue.slice(0);
  try{
    await fetch(SHEET_URL, {method:"POST", mode:"no-cors", headers:{"Content-Type":"text/plain;charset=utf-8"}, body:JSON.stringify({rows:batch})});
    queue.splice(0, batch.length); store.set("acc_queue", queue);
  }catch(e){ /* stays queued; retried on next check */ }
  flushing = false; updateStatus();
}

/* ---------- rendering ---------- */
function renderBlueprint(){
  $("#blueprint").innerHTML = DOMAINS.map(d => `<div class="bp"><b>${d.pts}</b><span>${esc(d.name)}</span><div class="bar"><i style="width:${(d.pts/21*100).toFixed(0)}%"></i></div></div>`).join("");
}
const VIEWS = [...DOMAINS.map(d => ({id:d.id, label:d.short})), {id:"formulas", label:"Formula Sheet"}, {id:"progress", label:"My Progress"}];
function renderTabs(active){
  $("#tabs").innerHTML = VIEWS.map(v => `<button role="tab" aria-selected="${v.id===active}" data-v="${v.id}">${esc(v.label)}</button>`).join("");
  $("#tabs").querySelectorAll("button").forEach(b => b.onclick = () => { location.hash = b.dataset.v; });
}
function renderItem(id, n){
  const it = ITEMS[id]; const st = state[id];
  let body = "";
  if(it.type==="mc") body = `<div class="choices" role="radiogroup">${it.opts.map(o => `<label class="choice" data-k="${o[0]}"><input type="radio" name="r_${id}" value="${o[0]}"><span><b>${o[0].length===1?o[0]+". ":""}</b>${o[1]}</span></label>`).join("")}</div>`;
  if(it.type==="multi") body = `<div class="choices">${it.opts.map(o => `<label class="choice" data-k="${o[0]}"><input type="checkbox" value="${o[0]}"><span>${o[1]}</span></label>`).join("")}</div>`;
  if(it.type==="num") body = `<div class="nums">${it.fields.map((f,i) => `<label for="n_${id}_${i}">${f[0]}<input type="text" inputmode="decimal" id="n_${id}_${i}" autocomplete="off"></label>`).join("")}</div>`;
  if(it.type==="lineplot") body = `<div class="tool" id="lp_${id}"></div>`;
  if(it.type==="parabola") body = `<div class="tool" id="pb_${id}"></div>`;
  return `<div class="item" id="item_${id}">
    <div class="meta"><span>Practice ${n}</span><span>${esc(it.src)}</span><span>${STD_OF[id]}</span></div>
    <div class="stem">${it.stem}</div>${body}
    <div class="actions"><button class="btn" data-check="${id}">Check answer</button>${st?`<span class="note">First try: ${st.firstCorrect?"correct":"not yet"} · tries: ${st.attempts}</span>`:""}</div>
    <div class="fbwrap"></div></div>`;
}
function renderDomain(d){
  return `<section class="domain"><div class="dhead"><div class="eyebrow">${d.pts} of 58 points</div><h2>${esc(d.name)}</h2><p>${d.intro}</p></div>
  ${d.standards.map(s => `<article class="std">
    <div class="top"><span class="code">${s.code} · ${s.unit}</span><h3>${s.title}</h3><p class="stdtext">${s.text}</p></div>
    <div class="part"><div class="lab"><span class="tag t-learn">Key ideas</span></div><ul class="keys">${s.keys.map(k => `<li>${k}</li>`).join("")}</ul></div>
    <div class="part"><div class="lab"><span class="tag t-ex">Worked examples</span></div>${s.examples.map(e => `<div class="ex"><p class="q">${e.q}</p><ol>${e.steps.map(x => `<li>${x}</li>`).join("")}</ol><span class="src">${esc(e.src)}</span></div>`).join("")}</div>
    <div class="part"><div class="lab"><span class="tag t-warn">Watch out</span></div><div class="mis">${s.mis.map(m => `<div class="mi"><span class="x">✕</span><p><b>${m.t}</b>${m.d}</p></div>`).join("")}</div></div>
    <div class="part"><div class="lab"><span class="tag t-prac">Practice</span><span class="note">${s.items.length} items</span></div>${s.items.map((id,i) => renderItem(id,i+1)).join("")}</div>
  </article>`).join("")}</section>`;
}
function renderFormulas(){
  const F = [
   ["Slope","m = (y₂ − y₁) / (x₂ − x₁)"],["Linear equations","Slope-intercept: y = mx + b<br>Point-slope: y − y₁ = m(x − x₁)<br>Standard: Ax + By = C"],
   ["Arithmetic sequence","Recursive: aₙ = aₙ₋₁ + d<br>Explicit: aₙ = a₁ + (n − 1)d"],["Distance","d = √((x₂ − x₁)² + (y₂ − y₁)²)"],["Midpoint","((x₁ + x₂)/2, (y₁ + y₂)/2)"],
   ["Exponential equation","y = abˣ"],["Geometric sequence","Recursive: aₙ = r(aₙ₋₁)<br>Explicit: aₙ = a₁rⁿ⁻¹"],["Compound interest","A = P(1 + r/n)ⁿᵗ"],
   ["Quadratic equations","Standard: y = ax² + bx + c<br>Vertex: y = a(x − h)² + k<br>Factored: y = a(x − p)(x − q)"],["Quadratic formula","x = (−b ± √(b² − 4ac)) / (2a)"],
   ["Average rate of change","Change in y ÷ change in x between two distinct points on a graph"],
   ["Mean","x̄ = (x₁ + x₂ + ... + xₙ) / n"],["Interquartile range","IQR = Q₃ − Q₁"],["Outliers","More than 1.5 × IQR below Q₁ or above Q₃"],
   ["Standard deviation","Square each value's distance from the mean, add them, divide by the number of values, then take the square root"]];
  return `<section class="domain"><div class="dhead"><div class="eyebrow">Provided during the test</div><h2>Formula Sheet</h2><p>These are the formulas on the official Algebra: Concepts and Connections Formula Sheet. You get this sheet on test day, so practice using it instead of memorizing it.</p></div>
  <div class="formula">${F.map(f => `<div class="fbox"><h4>${f[0]}</h4><p>${f[1]}</p></div>`).join("")}</div></section>`;
}
function renderProgress(){
  const rows = []; DOMAINS.forEach(d => d.standards.forEach(s => {
    const done = s.items.filter(id => state[id]); const right = done.filter(id => state[id].firstCorrect).length;
    rows.push({code:s.code, title:s.title, total:s.items.length, done:done.length, right});
  }));
  return `<section class="domain"><div class="dhead"><div class="eyebrow">First-try results on this device</div><h2>My Progress</h2><p>Each bar shows how many practice items you got right on your first try, out of the ones you've tried. Go back to any standard below 70% and reread its worked examples and traps.</p></div>
  <div class="progress">${rows.map(r => { const p = r.done ? r.right/r.done : 0; const cls = !r.done ? "" : p>=.8?"hi":p>=.7?"mid":"lo";
    return `<div class="prow"><div><b class="code">${r.code}</b> ${r.title}<div class="note">${r.done} of ${r.total} tried</div></div><div class="bar"><i class="${cls}" style="width:${(p*100).toFixed(0)}%"></i></div><b class="mono">${r.done?Math.round(p*100)+"%":"–"}</b></div>`; }).join("")}</div>
  <div class="actions"><button class="btn ghost" id="resendBtn">Send any unsent results</button></div></section>`;
}

/* ---------- interactive tools ---------- */
const tools = {};
function mountLineplot(id){
  const box = document.getElementById("lp_"+id); if(!box) return;
  const it = ITEMS[id]; const added = (tools[id] = tools[id] || {added:[]}).added;
  const W=520,H=150,pad=24, sx = v => pad + v*(W-2*pad)/12;
  const draw = () => {
    const counts = {}; let c = "";
    c += `<line class="ax" x1="${pad-10}" y1="120" x2="${W-pad+10}" y2="120"/>`;
    for(let v=0; v<=12; v++){ c += `<line class="ax" x1="${sx(v)}" y1="115" x2="${sx(v)}" y2="125"/><text x="${sx(v)}" y="142" text-anchor="middle">${v}</text><rect x="${sx(v)-18}" y="0" width="36" height="150" fill="transparent" data-v="${v}" style="cursor:pointer"/>`; }
    it.given.forEach(v => { counts[v]=(counts[v]||0)+1; c += `<text x="${sx(v)}" y="${112-(counts[v]-1)*20}" text-anchor="middle" style="font-size:16px" pointer-events="none">×</text>`; });
    added.forEach(v => { counts[v]=(counts[v]||0)+1; c += `<text x="${sx(v)}" y="${112-(counts[v]-1)*20}" text-anchor="middle" style="font-size:16px;fill:var(--accent);font-weight:700" pointer-events="none">×</text>`; });
    box.innerHTML = `<div class="tablewrap"><svg class="fig" viewBox="0 0 ${W} ${H}" width="${W}"><text x="${W/2}" y="14" text-anchor="middle" style="font-weight:600">Theo's Data</text>${c}</svg></div><p class="note">Your points: ${added.length?added.slice().sort((a,b)=>a-b).join(", "):"none yet"} (${added.length} of 2)</p>`;
    box.querySelectorAll("rect[data-v]").forEach(r => r.onclick = () => {
      const v = +r.dataset.v; const i = added.indexOf(v);
      if(i>=0) added.splice(i,1); else if(added.length<2) added.push(v);
      draw();
    });
  };
  draw();
}
function mountParabola(id){
  const box = document.getElementById("pb_"+id); if(!box) return;
  const t = tools[id] = tools[id] || {pts:[]};
  const W=420,H=330,pad=34;
  const sx = x => pad + x*(W-2*pad)/12, sy = y => H-pad - y*(H-2*pad)/120;
  const draw = () => {
    let c = "";
    for(let x=0;x<=12;x++) c += `<line class="gl" x1="${sx(x)}" y1="${sy(0)}" x2="${sx(x)}" y2="${sy(120)}"/><text x="${sx(x)}" y="${sy(0)+15}" text-anchor="middle">${x}</text>`;
    for(let y=0;y<=120;y+=10) c += `<line class="gl" x1="${sx(0)}" y1="${sy(y)}" x2="${sx(12)}" y2="${sy(y)}"/><text x="${sx(0)-5}" y="${sy(y)+4}" text-anchor="end">${y}</text>`;
    c += `<line class="ax" x1="${sx(0)}" y1="${sy(0)}" x2="${sx(12)}" y2="${sy(0)}"/><line class="ax" x1="${sx(0)}" y1="${sy(0)}" x2="${sx(0)}" y2="${sy(120)}"/>`;
    c += `<text x="${W/2}" y="${H-2}" text-anchor="middle">Time (seconds)</text><text x="10" y="${H/2}" transform="rotate(-90 10 ${H/2})" text-anchor="middle">Height above canyon (m)</text>`;
    if(t.pts.length===2){
      const [v,p] = t.pts; const a = (p[0]===v[0]) ? null : (p[1]-v[1])/Math.pow(p[0]-v[0],2);
      if(a!==null){ let d="",first=true; for(let i=0;i<=240;i++){ const x=i/20, y=a*(x-v[0])**2+v[1]; if(y<0||y>120) {first=true; continue;} d += (first?"M":"L")+sx(x)+" "+sy(y); first=false; } c += `<path class="ln" d="${d}"/>`; }
    }
    t.pts.forEach((p,i) => c += `<circle cx="${sx(p[0])}" cy="${sy(p[1])}" r="5" style="fill:${i?"var(--blue)":"var(--accent)"}"/>`);
    box.innerHTML = `<div class="tablewrap"><svg class="fig" viewBox="0 0 ${W} ${H}" width="${W}" id="svg_${id}"><text x="${W/2}" y="14" text-anchor="middle" style="font-weight:600">Kayla's Rock</text>${c}</svg></div>
      <p class="note">${t.pts.length===0?"Tap the vertex.":t.pts.length===1?`Vertex at (${t.pts[0].join(", ")}). Now tap a second point.`:`Vertex (${t.pts[0].join(", ")}), point (${t.pts[1].join(", ")}).`}</p>
      <div class="actions"><button class="btn ghost" id="pbreset_${id}">Start over</button></div>`;
    const svg = document.getElementById("svg_"+id);
    svg.onclick = ev => {
      if(t.pts.length>=2) return;
      const r = svg.getBoundingClientRect(); const px = (ev.clientX-r.left)*W/r.width, py = (ev.clientY-r.top)*H/r.height;
      const x = Math.round((px-pad)/(W-2*pad)*12), y = Math.round(((H-pad-py)/(H-2*pad)*120)/10)*10;
      if(x<0||x>12||y<0||y>120) return;
      if(t.pts.length===1 && t.pts[0][0]===x) return;
      t.pts.push([x,y]); draw();
    };
    document.getElementById("pbreset_"+id).onclick = () => { t.pts = []; draw(); };
  };
  draw();
}

/* ---------- checking ---------- */
const num = s => { const v = parseFloat(String(s).replace(/[$,\s]/g,"")); return isNaN(v) ? null : v; };
function check(id){
  const it = ITEMS[id]; const root = document.getElementById("item_"+id);
  let correct=false, response="", correctAns="", tag="";
  if(it.type==="mc"){
    const sel = root.querySelector("input:checked"); if(!sel) return feedback(root,null,"Choose an answer first.");
    response = sel.value; correct = response===it.ans; correctAns = it.ans;
    tag = correct ? "" : it.opts.find(o => o[0]===response)[2];
    root.querySelectorAll(".choice").forEach(c => { c.classList.remove("right","wrong"); if(c.dataset.k===it.ans) c.classList.add("right"); else if(c.dataset.k===response) c.classList.add("wrong"); });
  }
  if(it.type==="multi"){
    const sel = [...root.querySelectorAll("input:checked")].map(x => x.value); if(!sel.length) return feedback(root,null,"Select at least one answer.");
    response = sel.join(","); correctAns = it.ans.join(",");
    const missed = it.ans.filter(a => !sel.includes(a)), extra = sel.filter(a => !it.ans.includes(a));
    correct = !missed.length && !extra.length;
    tag = [...extra, ...missed].map(k => it.wrongTags[k]).filter((v,i,a) => a.indexOf(v)===i).join("; ");
    root.querySelectorAll(".choice").forEach(c => { c.classList.remove("right","wrong"); if(it.ans.includes(c.dataset.k)) c.classList.add("right"); else if(sel.includes(c.dataset.k)) c.classList.add("wrong"); });
  }
  if(it.type==="num"){
    const vals = it.fields.map((f,i) => num(document.getElementById(`n_${id}_${i}`).value));
    if(vals.some(v => v===null)) return feedback(root,null,"Enter a number in every box.");
    response = vals.join(" | "); correctAns = it.fields.map(f => f[1]).join(" | ");
    const bad = it.fields.map((f,i) => Math.abs(vals[i]-f[1]) > f[2]);
    correct = !bad.includes(true);
    if(!correct){ const i = bad.indexOf(true); tag = it.tagFor(vals[i], i); }
  }
  if(it.type==="lineplot"){
    const a = (tools[id]||{added:[]}).added.slice().sort((x,y)=>x-y);
    if(a.length!==2) return feedback(root,null,"Add exactly two points.");
    response = a.join(","); correctAns = it.ans.join(",");
    correct = a[0]===it.ans[0] && a[1]===it.ans[1];
    if(!correct){ const d = it.given.concat(a).sort((x,y)=>x-y);
      const sumOK = d.reduce((s,v)=>s+v,0)===60, rangeOK = d[7]-d[0]===6, medOK = (d[3]+d[4])/2===7;
      tag = [!sumOK&&it.tags.wrongSum, !rangeOK&&it.tags.wrongRange, !medOK&&it.tags.wrongMedian].filter(Boolean).join("; "); }
  }
  if(it.type==="parabola"){
    const t = tools[id]||{pts:[]}; if(t.pts.length<2) return feedback(root,null,"Place the vertex and one more point.");
    const [v,p] = t.pts; const a = (p[1]-v[1])/Math.pow(p[0]-v[0],2);
    response = `vertex (${v.join(",")}), point (${p.join(",")})`; correctAns = "vertex (2,100), through (0,80)";
    const vOK = v[0]===2 && v[1]===100, aOK = Math.abs(a+5)<1e-9;
    correct = vOK && aOK; tag = [!vOK&&it.tags.vertex, !aOK&&it.tags.point].filter(Boolean).join("; ");
  }
  const st = state[id] || {attempts:0, firstCorrect:null};
  st.attempts++; if(st.firstCorrect===null) st.firstCorrect = correct;
  state[id] = st; store.set("acc_state", state);
  logResult(id, correct, response, correctAns, tag, st.attempts);
  feedback(root, correct, it.why);
  const note = root.querySelector(".actions .note"); const txt = `First try: ${st.firstCorrect?"correct":"not yet"} · tries: ${st.attempts}`;
  if(note) note.textContent = txt; else root.querySelector(".actions").insertAdjacentHTML("beforeend", `<span class="note">${txt}</span>`);
}
function feedback(root, ok, html){
  const w = root.querySelector(".fbwrap");
  if(ok===null){ w.innerHTML = `<div class="fb bad"><span>${html}</span></div>`; return; }
  w.innerHTML = `<div class="fb ${ok?"good":"bad"}"><b class="v">${ok?"Correct.":"Not yet. Here's how to get it:"}</b><span>${html}</span></div>`;
}

/* ---------- router ---------- */
function show(){
  const v = (location.hash||"").slice(1); const active = VIEWS.some(x => x.id===v) ? v : DOMAINS[0].id;
  renderTabs(active);
  const d = DOMAINS.find(x => x.id===active);
  $("#main").innerHTML = d ? renderDomain(d) : active==="formulas" ? renderFormulas() : renderProgress();
  if(d) d.standards.forEach(s => s.items.forEach(id => { if(ITEMS[id].type==="lineplot") mountLineplot(id); if(ITEMS[id].type==="parabola") mountParabola(id); }));
  $("#main").querySelectorAll("[data-check]").forEach(b => b.onclick = () => check(b.dataset.check));
  const rb = document.getElementById("resendBtn"); if(rb) rb.onclick = flush;
}
window.addEventListener("hashchange", () => { show(); window.scrollTo({top:$("#tabs").offsetTop - 8}); });
renderBlueprint(); show(); updateStatus(); flush();
