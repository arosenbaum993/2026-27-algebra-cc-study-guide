 IB56I:{src:"GaDOE Item Bank 56A2024, Part C · DOK 3", stem:`<p>Hours studied: 4, 6, 7, 8, 8, 9, 10, 10, 11, 12, 14, 18, 22, 25. Calculate the interquartile range.</p>`,
  type:"num", fields:[["IQR",6,0.001]], tagFor:v => v===21 ? "Gave the range instead of the IQR" : "Quartile error",
  why:"Lower half: 4, 6, 7, 8, 8, 9, 10 → Q<sub>1</sub> = 8. Upper half: 10, 11, 12, 14, 18, 22, 25 → Q<sub>3</sub> = 14. IQR = 14 − 8 = 6."},
 IB56O:{src:"GaDOE Item Bank 56A2024, Part A · DOK 3", stem:`<p>Hours studied: 4, 6, 7, 8, 8, 9, 10, 10, 11, 12, 14, 18, 22, 25. Using the 1.5 × IQR rule, which value is an outlier?</p>`,
  type:"mc", opts:[["18","18","Outlier fence error"],["22","22","Outlier fence error (22 is inside the fence of 23)"],["25","25",""],["none","There are no outliers","Did not apply the 1.5 × IQR rule"]], ans:"25",
