const GUIDE_VERSION = "2026-27 v1";

/* ---------- small helpers ---------- */
const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const store = {
  get(k, d){ try{ const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; }catch(e){ return d; } },
  set(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }
};

/* ---------- small SVG figure builders (drawn from the source items) ---------- */
function gridSVG({xmin,xmax,ymin,ymax,w,h,step=1,ystep=1,content="",labelEvery=1,ylabelEvery=1,pad=26}){
  const sx = x => pad + (x - xmin) / (xmax - xmin) * (w - 2*pad);
  const sy = y => h - pad - (y - ymin) / (ymax - ymin) * (h - 2*pad);
  let g = "";
  for(let x=xmin;x<=xmax+1e-9;x+=step) g += `<line class="gl" x1="${sx(x)}" y1="${sy(ymin)}" x2="${sx(x)}" y2="${sy(ymax)}"/>`;
  for(let y=ymin;y<=ymax+1e-9;y+=ystep) g += `<line class="gl" x1="${sx(xmin)}" y1="${sy(y)}" x2="${sx(xmax)}" y2="${sy(y)}"/>`;
  const x0 = Math.min(Math.max(0,xmin),xmax), y0 = Math.min(Math.max(0,ymin),ymax);
  g += `<line class="ax" x1="${sx(xmin)}" y1="${sy(y0)}" x2="${sx(xmax)}" y2="${sy(y0)}"/><line class="ax" x1="${sx(x0)}" y1="${sy(ymin)}" x2="${sx(x0)}" y2="${sy(ymax)}"/>`;
  for(let x=xmin;x<=xmax+1e-9;x+=step*labelEvery){ if(Math.abs(x)>1e-9) g += `<text x="${sx(x)}" y="${sy(y0)+14}" text-anchor="middle">${+x.toFixed(2)}</text>`; }
  for(let y=ymin;y<=ymax+1e-9;y+=ystep*ylabelEvery){ if(Math.abs(y)>1e-9) g += `<text x="${sx(x0)-5}" y="${sy(y)+4}" text-anchor="end">${+y.toFixed(2)}</text>`; }
  return {svg:`<svg class="fig" viewBox="0 0 ${w} ${h}" width="${w}" role="img">${g}${content}</svg>`, sx, sy};
}
function scatterFig(points, line, caption){
  const base = gridSVG({xmin:0,xmax:8,ymin:0,ymax:8,w:210,h:210});
  const {sx,sy} = base;
  let c = `<line class="ln" x1="${sx(line[0])}" y1="${sy(line[1])}" x2="${sx(line[2])}" y2="${sy(line[3])}"/>`;
  points.forEach(p => c += `<circle class="pt" cx="${sx(p[0])}" cy="${sy(p[1])}" r="3.5"/>`);
  const g = gridSVG({xmin:0,xmax:8,ymin:0,ymax:8,w:210,h:210,content:c});
  return `<figure>${g.svg}<figcaption>${caption}</figcaption></figure>`;
}
function lineFigQ14(){
  const b = gridSVG({xmin:-6,xmax:6,ymin:-6,ymax:6,w:300,h:300});
  const c = `<line class="ln" x1="${b.sx(-5.25)}" y1="${b.sy(-6.5)}" x2="${b.sx(1.25)}" y2="${b.sy(6.5)}"/><text x="${b.sx(1.4)}" y="${b.sy(6.2)}">f(x)</text>`;
  return gridSVG({xmin:-6,xmax:6,ymin:-6,ymax:6,w:300,h:300,content:c}).svg;
}
function triangleFig(){
  const b = gridSVG({xmin:-6,xmax:6,ymin:-4,ymax:5,w:320,h:250});
  const P = [[1,4,"A(1, 4)"],[4,1,"B(4, 1)"],[-3,0,"C(−3, 0)"]];
  let c = `<polygon class="tri" points="${P.map(p=>b.sx(p[0])+","+b.sy(p[1])).join(" ")}"/>`;
  P.forEach(p => c += `<circle class="pt" cx="${b.sx(p[0])}" cy="${b.sy(p[1])}" r="3.5"/><text x="${b.sx(p[0])+6}" y="${b.sy(p[1])-6}">${p[2]}</text>`);
  return gridSVG({xmin:-6,xmax:6,ymin:-4,ymax:5,w:320,h:250,content:c}).svg;
}
function jamFig(){
  const b = gridSVG({xmin:0,xmax:5,ymin:0,ymax:5,w:260,h:230});
  let d = ""; for(let i=0;i<=50;i++){ const x=i/10, y=2*Math.pow(1.2,x); d += (i?"L":"M")+b.sx(x)+" "+b.sy(y); }
  const c = `<path class="ln" d="${d}"/><circle class="pt" cx="${b.sx(0)}" cy="${b.sy(2)}" r="3.5"/><circle class="pt" cx="${b.sx(1)}" cy="${b.sy(2.4)}" r="3.5"/><text x="${b.sx(0)+6}" y="${b.sy(2)+16}">(0, 2)</text><text x="${b.sx(1)+6}" y="${b.sy(2.4)-6}">(1, 2.4)</text>`;
  return `<div><b>Raspberry Jam Costs</b> <span class="note">(x = years since company opened, y = cost per container in dollars)</span></div>` + gridSVG({xmin:0,xmax:5,ymin:0,ymax:5,w:260,h:230,content:c}).svg;
}
const JAM_STEM = `<p>A company that produces strawberry, grape, and raspberry jam tracked the costs to make each type of jam each year. The cost to make a container of each type of jam increased, including supply costs. The costs, in dollars, to make a container of the strawberry jam and the grape jam are represented by the functions shown, where <i>x</i> represents the number of years since the company opened.</p>
<p><b>Strawberry Jam:</b> <span class="math">s(x) = 3.10 + 0.05x</span><br><b>Grape Jam:</b> <span class="math">g(x) = 0.01(x − 1)<sup>2</sup> + 2.95</span></p>
<p>The graph of the exponential function <i>r</i>(<i>x</i>) shown represents the cost, in dollars, to make a container of the raspberry jam.</p>`;

/* =====================================================================
