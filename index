 IB60:{src:"GaDOE Item Bank 60A2024 · DOK 2", stem:`<p>David's garden path goes from (2, 5) to (8, 10). Find its length to the nearest hundredth.</p>`,
  type:"num", fields:[["Length",7.81,0.011]], tagFor:v => v===11 ? "Added the horizontal and vertical changes" : Math.abs(v-61)<0.01 ? "Forgot the square root in the distance formula" : "Distance formula error",
